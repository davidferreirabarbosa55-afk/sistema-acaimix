# Copie este arquivo para ".env" (só para rodar no SEU computador com "npm run dev").
# Na Vercel, cadastre as mesmas variáveis em Settings › Environment Variables.
# NUNCA publique o .env: ele tem a chave secreta do banco.

# ---- Supabase (Project Settings › API Keys) ----
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA (começa com sb_secret_). Nunca use a chave publishable aqui.
SUPABASE_SECRET_KEY=

# ---- Acessos (usados só na primeira vez, para criar os usuários) ----
ADMIN_USUARIO=admin
ADMIN_SENHA=
COZINHA_USUARIO=cozinha
COZINHA_SENHA=

# ---- Mercado Pago (deixe vazio para o modo de teste com pagamento simulado) ----
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Nome na fatura do cartão (até 13 letras, sem acento)
NOME_FATURA=ACAIMIX

# Endereço público do site. Na Vercel é preenchido sozinho com o domínio de produção.
URL_PUBLICA=

# Segredo do cron diário de manutenção (Vercel). Use 20+ letras e números aleatórios.
CRON_SECRET=

# LGPD: depois de quantos dias nome/telefone/e-mail dos clientes são apagados dos pedidos
RETENCAO_DIAS=180
# Fuso para os relatórios (Petrolina = -3)
FUSO_HORARIO=-3

PORTA=3000
