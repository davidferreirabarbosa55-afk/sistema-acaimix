# Copie este arquivo para ".env" e preencha. NUNCA publique o .env (ele tem suas chaves).

PORTA=3000

# ---- Acessos (usados só na primeira vez que o sistema roda) ----
# Depois, crie/edite usuários pelo painel em /admin > Usuários.
ADMIN_USUARIO=admin
ADMIN_SENHA=
COZINHA_USUARIO=cozinha
COZINHA_SENHA=

# Endereço público do site (https), usado no webhook e no retorno do cartão.
# Ex.: https://pedidos.acaimix.com.br
URL_PUBLICA=

# ---- Mercado Pago ----
# Painel do desenvolvedor > Suas integrações > (sua aplicação) > Credenciais.
# Use as credenciais de TESTE primeiro. Deixe vazio para o modo simulado.
MP_ACCESS_TOKEN=
# Suas integrações > Webhooks > "Assinatura secreta". Obrigatório em produção.
MP_WEBHOOK_SECRET=
# Nome que aparece na fatura do cartão do cliente (até 13 letras, sem acento)
NOME_FATURA=ACAIMIX

# LGPD: depois de quantos dias o nome, telefone e e-mail dos clientes são apagados dos pedidos
RETENCAO_DIAS=180

# Fuso horário para os relatórios (Petrolina/Nordeste = -3)
FUSO_HORARIO=-3

# Em produção (atrás de HTTPS):
NODE_ENV=development
# true se o app estiver atrás de um proxy (Nginx, Render, Railway...)
CONFIAR_PROXY=false
